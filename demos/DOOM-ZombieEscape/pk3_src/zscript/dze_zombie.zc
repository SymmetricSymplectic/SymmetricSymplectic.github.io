// ============================================================================
//  The Zombie Escape - dze_zombie.zc
//  Actores del experimento:
//
//    * LatticeZombie : la nube de zombis de Bernoulli(lambda). Sin colision; el
//      controlador les fija el origen en cada paso tras aplicar la transicion
//      geodesica l1.
//    * DZEMindy      : el marine NPC que conduce el algoritmo (APW o Greedy).
//      Es el objeto de estudio; el jugador ya no lo controla.
//    * DZEFreecam    : camara libre (actor invisible) a la que se engancha la
//      vista del jugador. Su posicion la fija el controlador para seguir al
//      marine desde fuera.
// ============================================================================

class LatticeZombie : Actor
{
    Default
    {
        Radius 16;
        Height 56;
        Speed 0;
        Health 1000000;
        Mass 100;

        // Sin colision ni interaccion con el jugador: se puede atravesar.
        -SOLID
        -SHOOTABLE
        -COUNTKILL
        -PUSHABLE
        -CORPSE
        +NOBLOOD
        +NOTELEPORT
        +NOGRAVITY

        RenderStyle "Normal";
    }

    States
    {
    Spawn:
        POSS A -1;
        Stop;
    }
}

// ============================================================================
//  DZEMindy: el marine que juega la reticula. Visualmente distinto de los zombis
//  (sprite de chaingunner, siempre iluminado y algo mas grande) para que se
//  siga sin confusion desde la camara libre.
// ============================================================================
class DZEMindy : Actor
{
    Default
    {
        Radius 16;
        Height 56;
        Speed 0;
        Health 1000000;
        Mass 100;

        -SOLID
        -SHOOTABLE
        -COUNTKILL
        -PUSHABLE
        -CORPSE
        +NOBLOOD
        +NOTELEPORT
        +NOGRAVITY
        +BRIGHT

        RenderStyle "Normal";
        Scale 1.3;
    }

    States
    {
    Spawn:
        PLAY A -1 Bright;
        Stop;
    }
}

// ============================================================================
//  DZEFreecam: actor invisible que sirve de camara. El motor usa su posicion,
//  su angulo y su pitch como punto de vista cuando se asigna a
//  players[].camera, asi que basta con moverlo cada tic para tener una vista
//  externa estable (sin tocar el pawn del jugador ni su usercmd).
// ============================================================================
class DZEFreecam : Actor
{
    Default
    {
        Radius 8;
        Height 8;
        Speed 0;
        Health 1000000;

        +NOINTERACTION
        +NOGRAVITY
        +NOTELEPORT
        -SOLID
        -SHOOTABLE
        -COUNTKILL
        -PUSHABLE
        -CORPSE
        +NOBLOOD

        RenderStyle "None";
        Alpha 0.0;
    }

    States
    {
    Spawn:
        TNT1 A -1;
        Stop;
    }
}
