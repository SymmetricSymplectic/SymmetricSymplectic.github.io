// ============================================================================
//  The Zombie Escape - dze_zombie.zc
//  Actor LatticeZombie: la representacion 3D de un zombi de la reticula.
//
//  El actor NO piensa ni se mueve por su cuenta: es una "marioneta" sin
//  colision cuyo origen fija DZEController en cada paso, despues de aplicar la
//  transicion geodesica l1 (ver dze_controller.zc). Asi la dinamica queda en un
//  unico lugar y el motor solo se encarga de dibujar.
// ============================================================================

class LatticeZombie : Actor
{
    Default
    {
        Radius 16;
        Height 56;
        Speed 0;
        Health 1000000;
        Mass 100;

        // Sin colision ni interaccion con el jugador: se puede atravesar.
        -SOLID
        -SHOOTABLE
        -COUNTKILL
        -PUSHABLE
        -CORPSE
        +NOBLOOD
        +NOTELEPORT

        // No se caen ni flotan al recolocarlos: el origen lo fija el controlador.
        +NOGRAVITY

        RenderStyle "Normal";
    }

    States
    {
    Spawn:
        POSS A -1;
        Stop;
    }
}

// ============================================================================
//  DZEGhost - la particula M_t^APW del "modo fantasma" (dze_controller == 3).
//  Se dibuja translucida para comparar en vivo la trayectoria humana con la
//  que habria seguido el controlador de Angel-Pralat-Winkler.
// ============================================================================
class DZEGhost : Actor
{
    Default
    {
        Radius 12;
        Height 48;
        Speed 0;
        Health 1000000;

        -SOLID
        -SHOOTABLE
        -COUNTKILL
        -PUSHABLE
        -CORPSE
        +NOBLOOD
        +NOTELEPORT
        +NOGRAVITY
        +BRIGHT

        RenderStyle "Add";
        Alpha 0.65;
        Scale 1.4;
    }

    States
    {
    Spawn:
        PLSS A -1 Bright;
        Stop;
    }
}
